# Nothing here is a build artefact of a committed file, but the scripts are
# sometimes imported by hand; keep bytecode out of the history.
__pycache__/
*.pyc

# Figure images are regenerated by the wrappers in figures/<site>/ from the
# committed data/<site>/; keep the binaries themselves out of the history.
# (Both the flat and the per-site depth are listed so that neither can slip in.)
figures/*.png
figures/*.jpg
figures/*.jpeg
figures/**/*.png
figures/**/*.jpg
figures/**/*.jpeg
