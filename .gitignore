# Nothing here is a build artefact of a committed file, but the scripts are
# sometimes imported by hand; keep bytecode out of the history.
__pycache__/
*.pyc

# A background run's log, not a source file: `nohup ... &` leaves it in the
# working tree when a wrapper is left running.
nohup.out

# Figure images are regenerated by the wrappers in figures/<site>/ from the
# committed data/<site>/; keep the binaries themselves out of the history.
# (Both the flat and the per-site depth are listed so that neither can slip in.
#  The vector PDF and EPS of figures/concept/ are regenerated binaries too: every
#  plate is written as raster + .pdf + .eps by code/figure_style.save(), none of
#  the three is a source.)
figures/*.png
figures/*.jpg
figures/*.jpeg
figures/*.pdf
figures/*.eps
figures/**/*.png
figures/**/*.jpg
figures/**/*.jpeg
figures/**/*.pdf
figures/**/*.eps
